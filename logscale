// Stage 1: narrow ClassifiedModuleLoad to candidate processes, one row per (cid, aid, TargetProcessId)
defineTable(
  name="cml_hits",
  query={
    #event_simpleName=ClassifiedModuleLoad
    | ImageFileName=/\\example\.dll$/i            // module of interest (adjust / remove)
    | TargetImageFileName=/\\rundll32\.exe$/i     // loading process (adjust / remove)
    | LoadedModule := ImageFileName
    | groupBy([cid, aid, TargetProcessId],
        function=[
          collect([LoadedModule, TargetImageFileName]),
          min(@timestamp, as=FirstModuleLoad),
          max(@timestamp, as=LastModuleLoad),
          count(as=ModuleLoadCount)
        ],
        limit=max)
  },
  include=[cid, aid, TargetProcessId, LoadedModule, TargetImageFileName,
           FirstModuleLoad, LastModuleLoad, ModuleLoadCount]
)

// Stage 2: pivot only into process events whose keys are in the table
| #event_simpleName=/^(Synthetic)?ProcessRollup2$/
| match(table="cml_hits", field=[cid, aid, TargetProcessId], strict=true)

// Stage 3: presentation
| ProcessStart    := formatTime("%F %T", field=ProcessStartTime, unit="seconds", timezone="UTC")
| FirstModuleLoad := formatTime("%F %T", field=FirstModuleLoad, timezone="UTC")
| LastModuleLoad  := formatTime("%F %T", field=LastModuleLoad,  timezone="UTC")
| rename(field=ImageFileName, as=ProcessImageFileName)
| table([cid, aid, TargetProcessId, RawProcessId,
         LoadedModule, TargetImageFileName, ProcessImageFileName,
         CommandLine, ParentBaseFileName, UserSid,
         ProcessStart, FirstModuleLoad, LastModuleLoad, ModuleLoadCount],
        limit=max)








defineTable(
  name="dll_hits",
  query={
    // Each event type is filtered on the field where the DLL actually appears
    (#event_simpleName=ClassifiedModuleLoad ImageFileName=/\\Microsoft\.PowerShell\.Editor\.ni\.dll$/i)
      or (#event_simpleName=ModuleDetectInfo TargetFileName=/\\Microsoft\.PowerShell\.Editor\.ni\.dll$/i)
    // Normalize the DLL path into one field regardless of source
    | case {
        #event_simpleName=ClassifiedModuleLoad | LoadedModule := ImageFileName ;
        #event_simpleName=ModuleDetectInfo     | LoadedModule := TargetFileName ;
      }
    | DetectSource := #event_simpleName
    | groupBy([cid, aid, TargetProcessId],
        function=[
          collect([LoadedModule, DetectSource]),
          min(@timestamp, as=FirstModuleLoad),
          max(@timestamp, as=LastModuleLoad),
          count(as=ModuleLoadCount)
        ],
        limit=max)
  },
  include=[cid, aid, TargetProcessId, LoadedModule, DetectSource,
           FirstModuleLoad, LastModuleLoad, ModuleLoadCount]
)
// Pivot: only w3wp processes with SharePoint in the command line, keyed to the DLL hits
| #event_simpleName=/^(Synthetic)?ProcessRollup2$/
| ImageFileName=/\\w3wp\.exe$/i
| CommandLine=/SharePoint/i
| match(table="dll_hits", field=[cid, aid, TargetProcessId], strict=true)
| ProcessStart    := formatTime("%F %T", field=ProcessStartTime, unit="seconds", timezone="UTC")
| FirstModuleLoad := formatTime("%F %T", field=FirstModuleLoad, timezone="UTC")
| LastModuleLoad  := formatTime("%F %T", field=LastModuleLoad,  timezone="UTC")
| rename(field=ImageFileName, as=ProcessImageFileName)
| table([cid, aid, TargetProcessId, RawProcessId,
         LoadedModule, DetectSource, ProcessImageFileName,
         CommandLine, ParentBaseFileName, UserSid,
         ProcessStart, FirstModuleLoad, LastModuleLoad, ModuleLoadCount],
        limit=max)



#event_simpleName=/^(ClassifiedModuleLoad|ModuleDetectInfo)$/
| in(field="aid", values=["<sharepoint_aid_1>", "<sharepoint_aid_2>"])
| case {
    #event_simpleName=ClassifiedModuleLoad
      | ImageFileName=/\\Microsoft\.PowerShell\.Editor\.ni\.dll$/i
      | TargetImageFileName=/\\w3wp\.exe$/i
      | LoadedModule := ImageFileName ;
    #event_simpleName=ModuleDetectInfo
      | TargetFileName=/\\Microsoft\.PowerShell\.Editor\.ni\.dll$/i
      | LoadedModule := TargetFileName ;
  }
| DetectSource := #event_simpleName
| groupBy([cid, aid, TargetProcessId],
    function=[collect([LoadedModule, DetectSource, TargetImageFileName]),
              min(@timestamp, as=FirstSeen),
              count(as=Hits)],
    limit=max)
